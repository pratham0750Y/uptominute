# Local MySQL connection for development. Set MYSQL_PASSWORD to the password
# assigned to MYSQL_USER in MySQL; do not commit your real .env file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=namma
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_DATABASE=namma

# Optional: enable Gemini AI replies in the Bengaluru assistant.
# Get a key from Google AI Studio and keep it only in this server-side .env file.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Optional: set to 0 to disable signups, or set SIGNUP_CODE to require an invite.
# ALLOW_SIGNUP=0
# SIGNUP_CODE=
